  m_Script: {fileID: 11500000, guid: 3431bdbd9766f1a4f845e04c3bbce9db, type: 3}
  m_Name: Dialog_Popu
  m_EditorClassIdentifier: 
  quests:
  - questID: POPU_STAR_5
    linesAt0:
    - "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C? \uC88B\uC740 \uC544\uCE68\uC785\uB2C8\uB2E4.
      \uB2EC\uCF64\uD558\uBA74\uC11C\uB3C4 \uC0C8\uCF64\uD55C \uBA54\uB274\uB97C
      \uC990\uAE30\uACE0 \uC2F6\uC740\uB370, \uD639\uC2DC \uC5B4\uB5A4 \uAC83\uC774
      \uC88B\uC744\uC9C0 \uCD94\uCC9C\uD574 \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
    linesAt1:
    - "\uC624, \uBCC4\uBE5B \uC720\uC131\uCC28\uB77C\uB2C8\uC694. \uAC10\uC0AC\uD569\uB2C8\uB2E4.
      \uC815\uB9D0 \uC544\uB984\uB2F5\uC2B5\uB2C8\uB2E4."
    linesAt2:
    - "\uC81C \uC785\uB9DB\uC5D0 \uAF2D \uB9DE\uB294 \uC74C\uB8CC\uB97C \uCD94\uCC9C\uD574
      \uC8FC\uC168\uAD70\uC694. \uB355\uBD84\uC5D0 \uAE30\uBD84\uC774 \uCC38 \uC88B\uC2B5\uB2C8\uB2E4.
      \uC55E\uC73C\uB85C\uB3C4 \uC885\uC885 \uB4E4\uB7EC \uC990\uACA8 \uB9C8\uC2DC\uACA0\uC2B5\uB2C8\uB2E4."
    linesAt3:
    - "\uC624\uB298\uB3C4 \uBCC0\uD568\uC5C6\uC774 \uD6CC\uB96D\uD55C \uB9DB\uC774\uAD70\uC694!
      \uB298 \uAC10\uC0AC\uB4DC\uB9BD\uB2C8\uB2E4."
    linesAt4:
    - "\uCC28 \uB355\uBD84\uC778\uC9C0 \uC81C \uB0A0\uAC1C \uB610\uD55C \uBCC4\uBE5B\uCC98\uB7FC
      \uC740\uC740\uD788 \uBC18\uC9DD\uC774\uB294 \uB4EF\uD558\uAD70\uC694."
    linesAt5:
    - "\uC774 \uCEE4\uD2BC\uC744 \uBCF4\uB2C8 \uBCC4\uBE5B \uC720\uC131\uCC28\uAC00
      \uC0DD\uAC01\uB098\uB354\uAD70\uC694. \uC0AC\uC7A5\uB2D8\uAED8 \uB4DC\uB9AC\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    linesAfterClear:
    - "\uC624\uB298\uB3C4 \uBCC0\uD568\uC5C6\uC774 \uD6CC\uB96D\uD55C \uB9DB\uC774\uAD70\uC694!
      \uB298 \uAC10\uC0AC\uB4DC\uB9BD\uB2C8\uB2E4."
  - questID: POPU_GHOST_5
    linesAt0:
    - "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C? \uC88B\uC740 \uC544\uCE68\uC785\uB2C8\uB2E4.
      \uB2EC\uCF64\uD558\uBA74\uC11C\uB3C4 \uC0C8\uCF64\uD55C \uBA54\uB274\uB97C
      \uC990\uAE30\uACE0 \uC2F6\uC740\uB370, \uD639\uC2DC \uC5B4\uB5A4 \uAC83\uC774
      \uC88B\uC744\uC9C0 \uCD94\uCC9C\uD574 \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
    linesAt1:
    - "\uC774 \uCC28\uB97C \uB9C8\uC2DC\uB2C8 \uC5B4\uCA50\uC9C0 \uC0B4\uC9DD \uC73C\uC2A4\uC2A4\uD55C
      \uAE30\uC6B4\uC774 \uB290\uAEF4\uC9C0\uB294\uAD70\uC694. \uD558\uD558."
    linesAt2:
    - "\uC870\uAE08\uC740 \uC2AC\uD508 \uB9DB\uC774 \uB290\uAEF4\uC9C0\uC9C0\uB9CC,
      \uC624\uD788\uB824 \uADF8\uB798\uC11C \uB354 \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uAD70\uC694."
    linesAt3:
    - "\uB530\uB73B\uD558\uBA74\uC11C\uB3C4 \uC740\uADFC\uD788 \uC309\uC300\uD55C
      \uAC8C, \uC624\uB798 \uAE30\uC5B5\uC5D0 \uB0A8\uC744 \uB9DB\uC785\uB2C8\uB2E4."
    linesAt4:
    - "\uC624\uB298\uC740 \uB2E4\uC18C \uC9C0\uCE5C \uD558\uB8E8\uC600\uB294\uB370,
      \uC774 \uCC28 \uB355\uBD84\uC5D0 \uB9C8\uC74C\uC774 \uC704\uB85C\uBC1B\uB294
      \uB4EF\uD569\uB2C8\uB2E4."
    linesAt5:
    - "\uC774 \uCC28\uB97C \uB9C8\uC2DC\uBA74 \uC660\uC9C0 \uC2AC\uD508 \uAE30\uC5B5\uB4E4\uC774
      \uC870\uAE08\uC740 \uC0AC\uB77C\uC9C8 \uAC83 \uAC19\uAD70\uC694."
    linesAfterClear:
    - "\uC624\uB298\uC740 \uB2E4\uC18C \uC9C0\uCE5C \uD558\uB8E8\uC600\uB294\uB370,
      \uC774 \uCC28 \uB355\uBD84\uC5D0 \uB9C8\uC74C\uC774 \uC704\uB85C\uBC1B\uB294
      \uB4EF\uD569\uB2C8\uB2E4."
  - questID: POPU_HOT_5
    linesAt0:
    - "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C? \uC88B\uC740 \uC544\uCE68\uC785\uB2C8\uB2E4.
      \uB2EC\uCF64\uD558\uBA74\uC11C\uB3C4 \uC0C8\uCF64\uD55C \uBA54\uB274\uB97C
      \uC990\uAE30\uACE0 \uC2F6\uC740\uB370, \uD639\uC2DC \uC5B4\uB5A4 \uAC83\uC774
      \uC88B\uC744\uC9C0 \uCD94\uCC9C\uD574 \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
    linesAt1:
    - "\uB9C8\uCE68 \uC870\uAE08 \uC73C\uC2AC\uC73C\uC2AC\uD558\uB358 \uCC38\uC774\uC5C8\uB294\uB370,
      \uB530\uB73B\uD558\uB2C8 \uCC38 \uC88B\uC2B5\uB2C8\uB2E4. \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    linesAt2:
    - "\uAF64 \uB728\uAC81\uAD70\uC694. \uCC9C\uCC9C\uD788 \uC2DD\uD600\uAC00\uBA70
      \uD638\uD638 \uBD88\uC5B4 \uB9C8\uC154\uC57C\uACA0\uC2B5\uB2C8\uB2E4. \uD558\uD558."
    linesAt3:
    - "\uC5ED\uC2DC \uB530\uB73B\uD55C \uAC83\uC774 \uBAB8\uC5D0 \uC88B\uC740 \uBC95\uC774\uC9C0\uC694.
      \uC798 \uB9C8\uC2DC\uACA0\uC2B5\uB2C8\uB2E4."
    linesAt4:
    - "\uB530\uB73B\uD55C \uAE30\uC6B4\uC774 \uC18D\uAE4C\uC9C0 \uC2A4\uBA70\uB4DC\uB294
      \uB290\uB08C\uC774\uB85C\uAD70\uC694."
    linesAt5:
    - "\uCC28\uBD84\uD788 \uC74C\uBBF8\uD558\uB2C8 \uD558\uB8E8\uC758 \uD53C\uB85C\uAC00
      \uD480\uB9AC\uB294 \uB4EF\uD569\uB2C8\uB2E4."
    linesAfterClear:
    - "\uBAB8\uC740 \uBB3C\uB860 \uB9C8\uC74C\uAE4C\uC9C0 \uB530\uB73B\uD574\uC9C0\uB294
      \uAE30\uBD84\uC774\uB85C\uAD70\uC694."
