MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 88c09b4af1a238744b0a6e6e81896cf0, type: 3}
  m_Name: Dialog_Yonyu
  m_EditorClassIdentifier: 
  npcID: YOUYU
  dialogs:
  - questID: YOUYU_STAR_4
    lines:
    - "\uC73C\uC74C~ \uC774\uAC70 \uC9C4\uC9DC \uB9DB\uC788\uB124!"
    - "\uC774 \uCC28 \uB9C8\uC2DC\uB2C8\uAE4C \uBC24\uC5D0\uB3C4 \uD798\uC774 \uB0A0
      \uAC83 \uAC19\uC740\uB370!"
    - "\uB09C \uB0AE\uC5D0 \uD587\uB2D8 \uBCF4\uBA74\uC11C \uB6F0\uC5B4\uB2E4\uB2C8\uB294
      \uAC70 \uC88B\uC544\uD558\uAC70\uB4E0! \uADFC\uB370 \uBC24\uB9CC \uB418\uBA74
      \uC660\uC9C0 \uD798\uC774 \uBE60\uC838\uC11C... \uD55C \uC790\uB9AC\uC5D0\uB9CC
      \uC788\uAC8C \uB3FC."
    - "\uC774\uC81C \uBC24\uD558\uB298 \uBCC4 \uBCF4\uBA74\uC11C \uB6F0\uC5B4\uB2E4\uB2D0
      \uC218 \uC788\uACA0\uC5B4!"
    dialogSprite: {fileID: 21300000, guid: d060840d0d6e0014eb14affea33629b0, type: 3}
  - questID: YOUYU_DREAM_3
    lines:
    - "\uB098 \uC9C4\uC9DC \uC720\uC5F0\uD558\uB2E4? \uBAB8\uC774 \uCB49 \uB298\uC5B4\uB09C\uB2E4\uACE0!"
    - "\uB098\uB294 \uACE0\uC591\uC774\uAC00 \uB41C \uC774\uD6C4\uB85C \uBAB8\uC774
      \uB9D8\uB300\uB85C \uC6C0\uC9C1\uC774\uB294 \uAC8C \uC81C\uC77C \uC88B\uC544! "
    - "\uC881\uC740 \uAD6C\uBA4D\uB3C4 \uC3D9 \uB4E4\uC5B4\uAC00\uACE0! \uB192\uC740
      \uACF3\uB3C4 \uC0AC\uBFD0\uD788 \uB6F0\uC5B4\uC624\uB974\uACE0! (\uC2E0\uB0A8)"
    - "\uC774 \uC2A4\uBB34\uB514 \uBA39\uC73C\uB2C8\uAE4C \uB0B4 \uBAB8\uB3C4 \uBB38\uC5B4\uCC98\uB7FC
      \uB9D0\uB791\uB9D0\uB791\uD574\uC9C0\uB294 \uAC70 \uAC19\uC544"
    - "\uACE0\uC591\uC774\uAC00 \uB41C\uAC70\uBA74 \uC774\uC804\uC5D4 \uBB50\uC600\uB0D0\uACE0?"
    - "\uBAB0\uB77C. \uC544\uAE30 \uACE0\uC591\uC774?"
    dialogSprite: {fileID: 21300000, guid: d060840d0d6e0014eb14affea33629b0, type: 3}
  - questID: YOUYU_GHOST_2
    lines:
    - "\uC73C\uC74C... \uC624\uB298\uC740 \uAE30\uBD84\uC774 \uC880 \uBCC4\uB85C\uC57C...
      (\uC2DC\uBB34\uB8E9)"
    - "\uC65C \uADF8\uB7F0\uC9C0\uB294 \uBAA8\uB974\uACA0\uB294\uB370... \uC544\uBB34\uD2BC
      \uBCC4\uB85C\uB124."
    - "\uC608\uC804\uC5D0\uB294 \uB298 \uC606\uC5D0 \uB204\uAD70\uAC00\uAC00 \uC788\uC5C8\uB294\uB370..."
    - "\uC774 \uB77C\uB5BC\uB294 \uC660\uC9C0 \uB530\uB73B\uD558\uACE0... \uC2AC\uD508
      \uB9DB\uC774 \uB098\uB124."
    - "\uBAB0\uB77C. \uC544\uAE30 \uACE0\uC591\uC774?"
    dialogSprite: {fileID: 21300000, guid: 9b2416804d0e4384aa4c2335fc7d9c1e, type: 3}
  - questID: YOUYU_PEARL_3
    lines:
    - "\uBC14\uB2E4\uB294 \uBCC4\uB85C\uC57C... \uB0C4\uC0C8\uAC00 \uC774\uC0C1\uD574!"
    - "\uC9C4\uC8FC\uAC00 \uB4E4\uC5B4\uC788\uC5B4\uC11C \uB9C8\uC154\uBCF4\uB294
      \uAC74\uB370! \uBC14\uB2E4 \uB0C4\uC0C8\uB77C\uB2C8."
    - "\uADF8\uB798\uB3C4 \uC774\uAC70 \uB9DB\uC740 \uC788\uB124!"
    - "\uC2AC\uD390\uB358 \uAE30\uBD84\uC774 \uC2F9 \uC0AC\uB77C\uC84C\uC5B4!"
    - "\uB098\uD55C\uD14C\uB3C4... \uC5B8\uC820\uAC00 \uC88B\uC740 \uCE5C\uAD6C\uAC00
      \uC0DD\uAE38 \uAC83 \uAC19\uC740 \uAE30\uBD84\uC774\uC57C! (\uD558\uD2B8)"
    dialogSprite: {fileID: 21300000, guid: d060840d0d6e0014eb14affea33629b0, type: 3}
