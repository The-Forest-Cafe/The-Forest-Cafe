MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 88c09b4af1a238744b0a6e6e81896cf0, type: 3}
  m_Name: Dialog_Eebul
  m_EditorClassIdentifier: 
  npcID: EEBUL
  dialogs:
  - questID: EEBUL_GHOST_5
    lines:
    - "\uC73C\uC74C... \uC774 \uB9DB\uC740... \uC775\uC219\uD558\uAD70."
    - "\uC720\uB839 \uC2AC\uD514\uC774 \uB77C\uB5BC... \uB0B4 \uC2AC\uD514\uC774
      \uB179\uC544\uB4E4\uC5B4 \uAC04 \uB9DB\uC774 \uB098\uB294 \uAC83 \uAC19\uC544.
      (...)"
    - "\uC0AC\uC2E4... '\uBCC4\uC774'\uB77C\uB294 \uC774\uB984\uC758 \uC2AC\uD508
      \uC720\uB839\uC774 \uB098\uB97C \uB530\uB77C\uB2E4\uB2C8\uACE0 \uC788\uC5C8\uC9C0."
    - "\uBCC4\uC774\uB294 \uB098\uC758 \uC2AC\uD514\uC744 \uBA39\uACE0 \uC0AC\uB294
      \uC720\uB839\uC774\uC5C8\uC5B4. \uB0B4\uAC00 \uC2AC\uD50C\uC218\uB85D \uBCC4\uC774\uB294
      \uAE30\uBED0\uD588\uC9C0. (...) "
    - "\uADF8\uB7F0\uB370 \uADF8\uB9CC... \uB0B4\uAC00 \uAE38\uC744 \uC783\uC5B4\uBC84\uB9AC\uB294
      \uBC14\uB78C\uC5D0 \uBCC4\uC774\uB97C \uB193\uCCD0\uBC84\uB838\uC5B4. (\uC2AC\uD514)"
    - "\uC774 \uB77C\uB5BC \uB355\uBD84\uC5D0 \uB0B4 \uC2AC\uD514\uC774 \uBCC4\uB85C
      \uB0A8\uC9C0 \uC54A\uAC8C \uB418\uC5C8\uC9C0\uB9CC... \uADF8\uB798\uB3C4 \uAD1C\uCC2E\uC544."
    - "\uC774\uC81C \uBCC4\uC774\uB97C \uB2E4\uC2DC \uB9CC\uB0A0 \uC218 \uC788\uC744
      \uAC83 \uAC19\uC544. (\uAE30\uB300)"
    dialogSprite: {fileID: 21300000, guid: 9d1095f91974e444c905d8db3629864e, type: 3}
  - questID: EEBUL_STAR_2
    lines:
    - "\uC774 \uCC28... \uBCC4\uBE5B \uC720\uC131\uCC28\uB77C\uACE0? (\uC2E0\uAE30\uD568)"
    - "\uB9C8\uCE58 \uC720\uC131\uC6B0\uB97C \uB9C8\uC2DC\uB294 \uB290\uB08C\uC774\uAD70."
    - "\uBCC4\uC774\uB294 \uBCC4\uC744 \uCC38 \uC88B\uC544\uD588\uB294\uB370. \uBC24\uC774
      \uB418\uBA74 \uD558\uB298\uB9CC \uCCD0\uB2E4\uBD24\uC9C0."
    - "\uBCC4\uC774\uAC00 \uC5C6\uC5B4\uC9C0\uACE0 \uB098\uB294 \uB9E4\uC77C \uBC24
      \uBCC4\uB4E4\uC744 \uCC3E\uC544\uB2E4\uB154\uC5B4. \uD639\uC2DC \uBCC4\uC774\uAC00
      \uC720\uC131\uC774 \uB418\uC5B4 \uB098\uD0C0\uB098\uC9C4 \uC54A\uC744\uAE4C
      \uD558\uACE0."
    - "\uD558\uC9C0\uB9CC \uC544\uBB34\uB9AC \uCC3E\uC544\uB3C4 \uBCC4\uC774\uB294
      \uBCF4\uC774\uC9C0 \uC54A\uC558\uC5B4."
    - "\uADF8\uB7F0\uB370 \uC774 \uCC28\uB97C \uB9C8\uC2DC\uB2C8... \uBCC4\uC774\uC758
      \uB530\uB73B\uD55C \uC628\uAE30\uAC00 \uB290\uAEF4\uC9C0\uB294 \uAC83 \uAC19\uC544.
      (\uD3B8\uC548\uD568)"
    - "\uC774\uC81C \uB354 \uC774\uC0C1 \uBCC4\uC774\uB97C \uCC3E\uC544 \uD5E4\uB9E4\uC9C0
      \uC54A\uC544\uB3C4 \uB420 \uAC83 \uAC19\uC544."
    dialogSprite: {fileID: 21300000, guid: 9d1095f91974e444c905d8db3629864e, type: 3}
  - questID: EEBUL_DREAM_2
    lines:
    - "\uC774 \uC74C\uB8CC... \uC774\uB984\uC774 \uBB50\uC600\uC9C0? (\uD589\uBCF5)"
    - "\uBB38\uC5B4\uC758 \uAFC8 \uC2A4\uBB34\uB514\uB77C\uACE0?"
    - "\uBB38\uC5B4\uB294 \uAFC8\uC744 \uAFB8\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uD558\uB358\uB370...
      (\uC6C3\uC74C) "
    - "\uAFC8\uC744 \uC783\uC5B4\uBC84\uB9B0 \uBCC4\uC774\uC758 \uAFC8\uC744 \uB0B4\uAC00
      \uB300\uC2E0 \uAFB8\uC5B4\uC8FC\uACE0 \uC2F6\uC5C8\uB294\uB370..."
    - "\uC774\uC81C\uB294 \uC783\uC5B4\uBC84\uB9B0 \uAFC8\uC744 \uCC3E\uC744 \uC218
      \uC788\uC744 \uAC83 \uAC19\uC544. (\uD65C\uAE30\uCC38)"
    - "\uBCC4\uC774\uAC00 \uC788\uB294 \uACF3\uC774 \uBC14\uB85C \uB098\uC758 \uAFC8\uC774\uC5C8\uC73C\uB2C8\uAE4C."
    - "\uC790\uB124 \uB355\uBD84\uC5D0... \uC783\uC5B4\uBC84\uB9B0 \uAFC8\uB3C4,
      \uAE38\uB3C4, \uADF8\uB9AC\uACE0 \uBCC4\uC774\uB3C4 \uB2E4\uC2DC \uCC3E\uAC8C
      \uB41C \uAC83 \uAC19\uAD70. \uC815\uB9D0 \uACE0\uB9C8\uC6CC! (\uD558\uD2B8)"
    dialogSprite: {fileID: 21300000, guid: 9924f8f9dd95b4f49a0a5fa2070c36f0, type: 3}
