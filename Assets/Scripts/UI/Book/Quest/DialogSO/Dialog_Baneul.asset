--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 88c09b4af1a238744b0a6e6e81896cf0, type: 3}
  m_Name: Dialog_Baneul
  m_EditorClassIdentifier: 
  npcID: BANEUL
  dialogs:
  - questID: BANEUL_PEARL_8
    lines:
    - "...\uBB18\uD558\uB124. \uC774 \uB9DB, \uBC14\uB2F7\uC18D \uAE4A\uC740 \uB370\uC11C
      \uB4E4\uB824\uC624\uB294 \uC18C\uB9AC \uAC19\uC544."
    - "\uAC11\uC790\uAE30 \uC0DD\uAC01\uB0AC\uC5B4. \uBE44\uC5D0 \uC816\uC5B4\uBC84\uB9B0
      \uB0A0, \uADF8 \uC544\uC774\uAC00 \uB098\uB97C \uAF2D \uB04C\uC5B4\uC548\uC544
      \uC8FC\uB358 \uC21C\uAC04\uC774..."
    - "\uADF8 \uC544\uC774 \uB208\uB3D9\uC790... \uC9C4\uC8FC\uCC98\uB7FC \uB9D1\uACE0
      \uBC18\uC9DD\uC600\uC9C0."
    - "\uB09C... \uBC84\uB824\uC9C4 \uAC8C \uC544\uB2C8\uB77C, \uC5B8\uC81C\uB098
      \uADF8 \uC544\uC774 \uACC1\uC5D0 \uC788\uC5C8\uB358 \uAC78\uAE4C."
    dialogSprite: {fileID: 21300000, guid: 651cf51b44e0a8f47a9e1d34946570cc, type: 3}
  - questID: BANEUL_DREAM_8
    lines:
    - "\uCC28\uAC11\uACE0 \uB2EC\uCF64\uD55C\uB370, \uC774\uC0C1\uD558\uAC8C \uB530\uB73B\uD574\uC838."
    - "\uADF8 \uC544\uC774\uB294 \uC790\uC8FC \uC545\uBABD\uC744 \uAFE8\uC9C0. \uADF8\uB7F4
      \uB54C\uB9C8\uB2E4 \uB0B4 \uADC0\uB97C \uAF2D \uC7A1\uACE4 \uD588\uC5B4."
    - "\u2018\uAD1C\uCC2E\uC544, \uAD1C\uCC2E\uC544.\u2019 \uC18D\uC0AD\uC774\uB358
      \uC791\uC740 \uBAA9\uC18C\uB9AC\uAC00 \uC544\uC9C1\uB3C4 \uB4E4\uB9AC\uB294
      \uAC83 \uAC19\uC544."
    - "\uADF8 \uC21C\uAC04\uB9CC\uD07C\uC740 \uB0B4\uAC00 \uAF2D \uD544\uC694\uD55C
      \uC874\uC7AC\uC600\uB2E4\uB294 \uAC78... \uC774\uC81C\uC57C \uC54C\uACA0\uC5B4."
    dialogSprite: {fileID: 21300000, guid: 651cf51b44e0a8f47a9e1d34946570cc, type: 3}
  - questID: BANEUL_STAR_10
    lines:
    - "\uBE5B\uB098\uB294 \uBCC4\uBE5B... \uC624\uB79C\uB9CC\uC774\uAD70. \uCC3D\uBB38
      \uB108\uBA38\uB85C \uBCF4\uB358 \uD558\uB298\uC774 \uC0DD\uAC01\uB098."
    - "\uC544\uC774\uB294 \uB298 \uC18C\uC6D0\uC744 \uBE4C\uC5C8\uC5B4. \u2018\uBC14\uB298\uC774\uB791
      \uD3C9\uC0DD \uD568\uAED8 \uC788\uACE0 \uC2F6\uC5B4.\u2019 \uD558\uACE0..."
    - "\uADF8 \uB9D0\uC774 \uC601\uC6D0\uD560 \uAC70\uB77C \uBBFF\uC5C8\uB294\uB370...
      \uC544\uC774\uB294 \uCEE4\uAC00\uACE0, \uB098\uB294 \uADF8 \uC790\uB9AC\uC5D0
      \uB0A8\uACA8\uC84C\uC9C0."
    - "\uADF8\uB798\uB3C4 \uBC24\uD558\uB298 \uC18D\uC5D0 \uADF8 \uC57D\uC18D\uC740
      \uC544\uC9C1, \uC870\uC6A9\uD788 \uBC18\uC9DD\uC774\uACE0 \uC788\uB294 \uAC83
      \uAC19\uC544."
    dialogSprite: {fileID: 21300000, guid: 9579998953afbd441aa1a31e996d5fdf, type: 3}
  - questID: BANEUL_ALL_30
    lines:
    - "...\uC774\uC81C \uB2E4 \uAE30\uC5B5\uB0AC\uC5B4... \uC870\uAC01\uB09C \uAC83\uB4E4\uC774
      \uD558\uB098\uB85C \uC774\uC5B4\uC84C\uC5B4..."
    - "\uB098\uB294 \uC78A\uD78C \uAC8C \uC544\uB2C8\uC57C... \uC544\uC774\uC758
      \uC6C3\uC74C, \uB208\uBB3C... \uAFC8\uC744 \uC548\uACE0 \uC788\uB358 \uC778\uD615\uC774\uC5C8\uC5B4..."
    - "\uADF8\uB54C\uC758 \uB530\uB73B\uD568\uC740 \uC544\uC9C1\uB3C4 \uB0B4 \uC548\uC5D0 
      \uC0B4\uC544\uC788\uC5B4..."
    - "\uACE0\uB9C8\uC6CC... \uB355\uBD84\uC5D0 \uB098\uB294 \uBC84\uB824\uC9C4 \uAC8C
      \uC544\uB2C8\uB77C \uC18C\uC911\uD55C \uAE30\uC5B5\uC774\uB780 \uAC78 \uC54C\uC558\uC5B4..."
    - "\uC774\uC81C \uAE38\uC744 \uC783\uC9C0 \uC54A\uC544... \uC544\uC774\uB3C4...
      \uADF8\uB9AC\uACE0 \uB108\uB3C4 \uB0B4 \uC548\uC5D0  \uD568\uAED8 \uC788\uC73C\uB2C8\uAE4C..."
    dialogSprite: {fileID: 21300000, guid: 9579998953afbd441aa1a31e996d5fdf, type: 3}
